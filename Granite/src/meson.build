    'RecipientStore.vala',
    'RecipientEntry.vala',
    'EditorToolbar.vala',
    'MainWindow.vala',
    'InboxMonitor.vala',
    'NotificationTracker.vala',
    'Utils.vala',
    'WebView.vala',
    'WelcomeView.vala',
    'Backend/Account.vala',
    'Backend/ContactManager.vala',
    'Backend/Session.vala',
    'Backend/MoveOperation.vala',
    'Backend/TrashOperations.vala',
    'Backend/FolderOperations.vala',
    'SenderAvatar.vala',
    'AvatarStore.vala',
    'LogoCredentials.vala',
    'UndoBanner.vala',
    'Dialogs/PreferencesPanel.vala',
    'Dialogs/FolderDialog.vala',
    'ConversationList/ConversationItemModel.vala',
    'ConversationList/ConversationList.vala',
    'ConversationList/ConversationListItem.vala',
    'ConversationList/ConversationListStore.vala',
    'Dialogs/InsertLinkDialog.vala',
    'Dialogs/AliasDialog/Alias.vala',
    'Dialogs/AliasDialog/AliasDialog.vala',
    'Dialogs/SignatureDialog/Signature.vala',
    'Dialogs/SignatureDialog/SignatureDialog.vala',
    'FolderList' / 'AccountItemModel.vala',
    'FolderList' / 'FolderItemModel.vala',
    'FolderList' / 'FolderList.vala',
    'FolderList' / 'GroupedFolderItemModel.vala',
    'FolderList' / 'SessionItemModel.vala',
    'FoldersView/AccountSavedState.vala',
    'MessageList/AttachmentButton.vala',
    'MessageList/FolderPopover/FolderPopover.vala',
    'MessageList/FolderPopover/FolderRow.vala',
    'MessageList/MessageList.vala',
    'MessageList/MessageViewCache.vala',
    'MessageList/MessageListItem.vala',
    'SourceList/CellRendererBadge.vala',
    'SourceList/CellRendererExpander.vala',
    'SourceList/SourceList.vala',
    'SourceList' / 'SourceListSortable.vala',
    'VirtualizingListBox/VirtualizingListBoxRow.vala',
    'VirtualizingListBox/VirtualizingListBox.vala'
)

executable(
    application_id,
    vala_files,
    config_file,
    asresources,
    dependencies: dependencies,
    c_args: '-DWEBKIT_EXTENSION_PATH="' + webkit2_extension_path + '"',
    install: true
)
